# Local development values only. Copy to .env; never commit real credentials.
POSTGRES_DB=eip
POSTGRES_USER=eip
POSTGRES_PASSWORD=local-development-only
EIP_ENVIRONMENT=local
EIP_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
EIP_SESSION_TTL_SECONDS=43200
EIP_AUTH_IP_LIMIT=30
EIP_AUTH_ACCOUNT_LIMIT=10
EIP_AUTH_WINDOW_SECONDS=300
EIP_PASSWORD_HASH_CONCURRENCY=2

# Authenticated organization API budget per user.
EIP_API_USER_LIMIT=120
EIP_API_WINDOW_SECONDS=60
